# ═══ گزینه ۱ (پیش‌فرض): Qwen رسمی — Alibaba Cloud Model Studio ═══
# کلید رایگان: https://bailian.console.alibabacloud.com  (ساخت کلید از بخش API-KEY)
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=sk-xxxxxxxx

# ═══ گزینه ۲: SiliconFlow (اگر Alibaba از ایران باز نشد) ═══
# LLM_BASE_URL=https://api.siliconflow.com/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ═══ گزینه ۳: OpenRouter (مدل‌های :free رایگان) ═══
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3-235b-a22b:free

# ═══ گزینه ۴: Ollama لوکال (بدون اینترنت، بدون تحریم — پلن اضطراری) ═══
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama